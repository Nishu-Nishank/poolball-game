# Copy to server/.env (git-ignored). NEVER put these values in a VITE_* variable or under src/.
#
# Entra ID (Azure AD) app registration using the client-credentials flow, with the Microsoft Graph
# APPLICATION permission Sites.Selected (then grant it read access to the 4IBC site) — or, broader,
# Sites.Read.All. Admin consent is required.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The workbook to show. Defaults to the published 4IBC workbook; paste a new link here if it moves.
# SHAREPOINT_FILE_URL=https://4flowconsulting.sharepoint.com/:x:/r/sites/4IBC20264flowIndia8-BallChampionship/SiteAssets/Published/68d0b2b0-9077-46a8-8cc4-62c47a14a315/4IBC_2026_LIVE_Tournament%20(Published).xlsx

PORT=8787
# Graph is contacted at most once per CACHE_SECONDS; the file itself is re-downloaded only when it changes.
CACHE_SECONDS=30
