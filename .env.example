# ---- Frontend configuration (safe to expose: everything here ends up in the public bundle) ----
# NEVER put the Supabase service-role key or any secret in a VITE_* variable.

# Supabase project (Project settings -> API). The publishable/anon key is public by design:
# all tables are protected by Row Level Security and all privileged work runs on the server.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the dashboard reads its data from:
#   supabase (default when Supabase is configured) - dataset published by administrators
#   api      - the SharePoint workbook via the tournament server in server/ (needs Azure credentials)
#   static   - offline development: VITE_WORKBOOK_URL under public/ (.xlsx or .csv, comma-separated)
# VITE_DATA_SOURCE=supabase
# VITE_WORKBOOK_URL=/data/4IBC_2026_LIVE_Tournament.xlsx

# How often the dashboard checks for newly published results, in milliseconds (0 disables).
VITE_REFRESH_INTERVAL_MS=60000

# Time zone for all displayed timestamps (stored in UTC). IANA name; unset = each viewer's own zone.
VITE_DISPLAY_TIMEZONE=Asia/Kolkata

# Upload size limit shown in the admin UI (MB). The server enforces MAX_UPLOAD_BYTES independently.
VITE_MAX_UPLOAD_MB=5
