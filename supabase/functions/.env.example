# Edge Function configuration (set with: supabase secrets set --env-file supabase/functions/.env)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically - do not set them.

# Maximum accepted upload size in bytes (default 5 MB). Keep in sync with VITE_MAX_UPLOAD_MB.
MAX_UPLOAD_BYTES=5242880
# Browser origins allowed to call the function, comma-separated. "*" allows any origin
# (authorization is token-based, so this only limits which sites can embed the uploader).
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
